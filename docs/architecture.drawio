<diagram id="c4-context" name="1. Context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx-title" value="C4 уровень 1: System Context — Платформа для проведения опросов" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry"/></mxCell><mxCell id="ctx-participant" value="Участник опроса&lt;br&gt;[Person]&lt;br&gt;Голосует, смотрит результаты" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="50" height="100" as="geometry"/></mxCell><mxCell id="ctx-author" value="Автор опроса&lt;br&gt;[Person]&lt;br&gt;Создаёт и закрывает опросы" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="50" height="100" as="geometry"/></mxCell><mxCell id="ctx-system" value="&lt;b&gt;Платформа опросов&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;Создание опросов, приём голосов, подсчёт результатов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="300" height="160" as="geometry"/></mxCell><mxCell id="ctx-e1" value="Голосует, запрашивает результаты&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ctx-participant" target="ctx-system"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e2" value="Создаёт, просматривает и закрывает опросы&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ctx-author" target="ctx-system"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-note" value="Внешних систем нет: платформа самодостаточна и не интегрируется со сторонними сервисами." style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="500" width="360" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="c4-container" name="2. Container"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ct-title" value="C4 уровень 2: Container — Платформа для проведения опросов" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="ct-user" value="Пользователь&lt;br&gt;[Person]&lt;br&gt;участник / автор опроса" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="40" width="50" height="90" as="geometry"/></mxCell><mxCell id="ct-poll" value="&lt;b&gt;Poll Service&lt;/b&gt;&lt;br&gt;[Container: Java 21, Spring Boot 3.3, :8001]&lt;br&gt;Управление опросами и вариантами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#2e6295;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="260" height="110" as="geometry"/></mxCell><mxCell id="ct-vote" value="&lt;b&gt;Vote Service&lt;/b&gt;&lt;br&gt;[Container: Java 21, Spring Boot 3.3, :8002]&lt;br&gt;Приём голосов, защита от повторов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#2e6295;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="260" height="110" as="geometry"/></mxCell><mxCell id="ct-results" value="&lt;b&gt;Results Service&lt;/b&gt;&lt;br&gt;[Container: Java 21, Spring Boot 3.3, :8003]&lt;br&gt;Агрегация результатов, без собственной БД" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#2e6295;" vertex="1" parent="1"><mxGeometry x="1020" y="240" width="260" height="110" as="geometry"/></mxCell><mxCell id="ct-db" value="&lt;b&gt;PostgreSQL (db)&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL 16]&lt;br&gt;схемы poll и vote, volume db_data" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2f6f9f;fontColor=#ffffff;strokeColor=#1f4e75;" vertex="1" parent="1"><mxGeometry x="270" y="540" width="280" height="130" as="geometry"/></mxCell><mxCell id="ct-e1" value="Создаёт / закрывает опросы&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ct-user" target="ct-poll"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ct-e2" value="Голосует&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ct-user" target="ct-vote"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ct-e3" value="Смотрит результаты&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ct-user" target="ct-results"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ct-e4" value="Проверяет опрос и вариант: GET /api/polls/{id}&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ct-vote" target="ct-poll"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ct-e5" value="Счётчики: GET /api/votes/counts&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ct-results" target="ct-vote"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ct-e6" value="Опрос и варианты: GET /api/polls/{id}&lt;br&gt;[HTTP/JSON]" style="endArrow=classic;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.25;entryY=1;" edge="1" parent="1" source="ct-results" target="ct-poll"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="440"/><mxPoint x="125" y="440"/></Array></mxGeometry></mxCell><mxCell id="ct-e7" value="Читает / пишет, схема poll&lt;br&gt;[JDBC]" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ct-poll" target="ct-db">