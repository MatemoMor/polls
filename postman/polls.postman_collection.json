{
  "info": {
    "name": "Polls Platform - сценарий защиты",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "pollUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "voteUrl",
      "value": "http://localhost:8002"
    },
    {
      "key": "resultsUrl",
      "value": "http://localhost:8003"
    }
  ],
  "item": [
    {
      "name": "1. Создать опрос с 3 вариантами",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('3 варианта, опрос активен', () => { pm.expect(j.options.length).to.eql(3); pm.expect(j.is_active).to.eql(true); });",
              "pm.collectionVariables.set('pollId', j.id);",
              "pm.collectionVariables.set('optionA', j.options[0].id);",
              "pm.collectionVariables.set('optionB', j.options[1].id);",
              "pm.collectionVariables.set('optionC', j.options[2].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{pollUrl}}/api/polls"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Любимый язык программирования\", \"options\": [\"Java\", \"Python\", \"Go\"]}"
        }
      }
    },
    {
      "name": "2. Создать второй опрос (для проверки чужого варианта)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('otherOption', pm.response.json().options[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{pollUrl}}/api/polls"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Другой опрос\", \"options\": [\"Да\", \"Нет\"]}"
        }
      }
    },
    {
      "name": "3.1 Голос voter-1 за Java -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"poll_id\": \"{{pollId}}\", \"option_id\": \"{{optionA}}\", \"voter_id\": \"voter-1\"}"
        },
        "url": {
          "raw": "{{voteUrl}}/api/votes"
        }
      }
    },
