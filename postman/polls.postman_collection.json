        "body": {
          "mode": "raw",
          "raw": "{\"poll_id\": \"{{pollId}}\", \"option_id\": \"{{otherOption}}\", \"voter_id\": \"voter-99\"}"
        },
        "url": {
          "raw": "{{voteUrl}}/api/votes"
        }
      }
    },
    {
      "name": "6. Результаты в процентах (Java 60.0, Python 20.0, Go 20.0)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('5 голосов', () => pm.expect(j.total_votes).to.eql(5));",
              "pm.test('проценты', () => { pm.expect(j.results[0].percent).to.eql(60); pm.expect(j.results[1].percent).to.eql(20); pm.expect(j.results[2].percent).to.eql(20); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{resultsUrl}}/api/results/{{pollId}}"
        }
      }
    },
    {
      "name": "7. Закрыть опрос",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('опрос закрыт', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('closed'); pm.expect(j.is_active).to.eql(false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{pollUrl}}/api/polls/{{pollId}}/close"
        }
      }
    },
    {
      "name": "8. Голос в закрытый опрос -> 422",
      "event": [
        {
